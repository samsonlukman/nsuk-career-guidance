# Database (never commit a real password)
DATABASE_URL=postgresql+psycopg://apple@localhost:5432/nsuk_career
TEST_DATABASE_URL=postgresql+psycopg://apple@localhost:5432/nsuk_career_test

# Isolated evaluation database. Do not point this at nsuk_career.
# Mutating evaluation scripts also require EVALUATION_CONFIRM=I_UNDERSTAND
EVALUATION_DATABASE_URL=postgresql+psycopg://apple@localhost:5432/nsuk_career_eval
# EVAL_ADMIN_EMAIL=admin@example.edu
# EVAL_ADMIN_PASSWORD=set-in-the-shell-never-commit

# Comma-separated origins for the React frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT session signing secret (never commit a real value)
AUTH_SECRET=replace-with-a-long-random-string
AUTH_COOKIE_SECURE=false
AUTH_TOKEN_MINUTES=720
